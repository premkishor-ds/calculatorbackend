{
  "name": "vision-backend",
  "version": "1.0.0",
  "description": "Backend API for Vision Terminal Stock Portfolio",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "screener:sync": "node scripts/run-screener-sync.js",
    "screener:sync:force": "node scripts/run-screener-sync.js --force",
    "setup": "npm run db:up && npm run screener:sync:force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "echo \"No type-check specified\" && exit 0",
    "test": "echo \"No tests specified\" && exit 0",
    "build": "echo \"No build specified\" && exit 0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.3.1",
    "node-cron": "^4.2.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.20.1",
    "yahoo-finance2": "^3.14.1"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nodemon": "^3.1.0"
  },
  "private": true
}
